rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous' && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (request.auth.token.email == "xaeltan@gmail.com" && request.auth.token.email_verified == true));
    }

    function isSessionOwner(sessionId) {
      return isAuthenticated() && get(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerId == request.auth.uid;
    }

    function hasAdminAccess(sessionId) {
      return isAuthenticated() && (
        isAdmin() ||
        get(/databases/$(database)/documents/sessions/$(sessionId)).data.ownerId == request.auth.uid ||
        (request.auth.token.email != null &&
         exists(/databases/$(database)/documents/sessionAccess/$(sessionId)) &&
         request.auth.token.email in get(/databases/$(database)/documents/sessionAccess/$(sessionId)).data.adminEmails)
      );
    }

    function hasActiveProfile() {
      return isAuthenticated() && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.state == 'active';
    }

    match /profiles/{memberId} {
      allow read: if isAuthenticated() && (request.auth.uid == memberId || resource.data.state == 'active');
      allow create: if isAuthenticated() && request.auth.uid == memberId && validProfile();
      allow update: if isAuthenticated() && request.auth.uid == memberId && resource.data.state != 'deleting' && validProfile();
      allow delete: if false;
      function validProfile() {
        return request.resource.data.keys().hasOnly(['name', 'state']) && request.resource.data.state == 'active' && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100;
      }
    }
    // These documents are generated only by the validated server transaction.
    match /profileDetails/{memberId} {
      allow get: if isAuthenticated() && request.auth.uid == memberId && hasActiveProfile();
      allow write, list: if false;
    }
    match /memberDetails/{memberId} {
      allow get: if isAuthenticated() && get(/databases/$(database)/documents/profiles/$(memberId)).data.state == 'active';
      allow write, list: if false;
    }
    function hasAcceptedConnection(memberId) {
      let ownView = get(/databases/$(database)/documents/connectionViews/$(request.auth.uid)/peers/$(memberId)).data;
      let peerView = get(/databases/$(database)/documents/connectionViews/$(memberId)/peers/$(request.auth.uid)).data;
      let pair = get(/databases/$(database)/documents/connectionPairs/$(ownView.pairId)).data;
      return ownView.state == 'accepted' && peerView.state == 'accepted' &&
        ownView.pairId == peerView.pairId && ownView.generation == peerView.generation &&
        pair.state == 'accepted' && pair.generation == ownView.generation &&
        pair.members.size() == 2 && pair.members.hasAll([request.auth.uid, memberId]);
    }
    // Server-only canonical pair plus both mirrors must agree. Missing or partial
    // cleanup fails closed. A block changes canonical state and both mirrors.
    match /connectionContacts/{memberId} {
      allow get: if hasActiveProfile() &&
        get(/databases/$(database)/documents/profiles/$(memberId)).data.state == 'active' &&
        request.auth.uid != memberId && hasAcceptedConnection(memberId);
      allow list, write: if false;
    }
    match /connectionViews/{owner}/peers/{peer} {
      allow read: if hasActiveProfile() && request.auth.uid == owner;
      allow write: if false;
    }
    match /connectionPairs/{pair} { allow read, write: if false; }
    match /connectionBlocks/{owner}/targets/{target} { allow read, write: if false; }
    match /registrationDefaults/{memberId} {
      allow read: if isAuthenticated() && request.auth.uid == memberId;
      allow create, update: if isAuthenticated() && request.auth.uid == memberId && get(/databases/$(database)/documents/profiles/$(memberId)).data.state == 'active' && request.resource.data.keys().hasOnly(['adjective', 'designThinkingProficiency']) && request.resource.data.adjective is string && request.resource.data.adjective.size() <= 100 && request.resource.data.designThinkingProficiency in ['Experienced', 'Trained', 'Some exposure', 'New to it'];
    }
    match /registrations/{registrationId} {
      allow get: if isAuthenticated() && (registrationId.matches('.*~' + request.auth.uid) || resource.data.uid == request.auth.uid);
      allow list: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    // Private server records. Community history is an explicit API projection.
    match /attendance/{recordId} { allow read, write: if false; }
    match /attendanceAudit/{recordId} { allow read, write: if false; }
    match /historyVisibility/{recordId} { allow read, write: if false; }
    match /legacyParticipantSecrets/{participantId} { allow read, write: if false; }
    match /profileDeletionJobs/{memberId} { allow read, write: if false; }

    // Server-only sources, projections and audit. Verified audiences and profile
    // visibility are checked by the award API, never by a client-supplied role.
    match /eventResults/{eventId} { allow read, write: if false; }
    match /eventAwardCategories/{categoryId} { allow read, write: if false; }
    match /awardResults/{resultId} { allow read, write: if false; }
    match /awardAudits/{auditId} { allow read, write: if false; }
    match /memberAchievements/{memberId}/{document=**} { allow read, write: if false; }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && request.resource.data.role == 'user';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /sessionAccess/{sessionId} {
      allow read: if hasAdminAccess(sessionId);
      allow create, update: if hasAdminAccess(sessionId) && request.resource.data.keys().hasOnly(['ownerEmail', 'adminEmails']) && request.resource.data.adminEmails is list && request.resource.data.ownerEmail is string;
      allow delete: if isSessionOwner(sessionId) || isAdmin();
    }

    match /sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid && !request.resource.data.keys().hasAny(['ownerEmail', 'adminEmails', 'email', 'emailAddress', 'phone', 'phoneNumber', 'phoneLast4', 'passcode']);
      allow update: if hasAdminAccess(sessionId) && !request.resource.data.keys().hasAny(['ownerEmail', 'adminEmails', 'email', 'emailAddress', 'phone', 'phoneNumber', 'phoneLast4', 'passcode']) && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || isAdmin());
    }

    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (hasAdminAccess(request.resource.data.sessionId));
      allow update, delete: if isAuthenticated() && (hasAdminAccess(resource.data.sessionId));
    }

    match /resources/{resourceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (hasAdminAccess(request.resource.data.sessionId));
      allow update, delete: if isAuthenticated() && (hasAdminAccess(resource.data.sessionId));
    }

    function allocationEligibleData(member) {
      return member.get('identityState', '') != 'deleted' && member.get('participationState', 'active') == 'active' &&
        (!('officialRoles' in member) || 'participant' in member.officialRoles);
    }
    // Even staff clients cannot allocate a staff-only participation. Roles are
    // written only by the trusted event-roles endpoint, never by these rules.
    function validAllocationChange() {
      return allocationEligibleData(resource.data) || (
        request.resource.data.get('teamId', null) == null && request.resource.data.get('solutioning_team_id', null) == null &&
        request.resource.data.get('discoveryTeamId', null) == null && request.resource.data.get('discovery_team_id', null) == null &&
        request.resource.data.get('isAssigned', false) == false
      );
    }
    match /participants/{participantId} {
      allow read: if isAuthenticated();
      // Only the trusted registration transaction creates or links participants.
      allow create: if false;
      allow update: if isAuthenticated() && validAllocationChange() && (
        ((isAdmin() || hasAdminAccess(resource.data.sessionId)) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'adjective', 'designThinkingProficiency', 'teamId', 'isAssigned', 'selectedChallengeId', 'discoveryTeamId', 'discovery_team_id', 'solutioning_team_id', 'interestedFocusAreaId', 'interestedFocusAreaIds', 'archetypeScores', 'primaryArchetype', 'secondaryArchetype', 'persistedAnswers'])) ||
        (
          (resource.data.uid == request.auth.uid && resource.data.memberId == request.auth.uid && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.state == 'active') &&
          (
            // Always allowed fields for the participant themselves
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'adjective', 'designThinkingProficiency', 'teamId', 'isAssigned', 'selectedChallengeId', 'discoveryTeamId', 'discovery_team_id', 'solutioning_team_id', 'interestedFocusAreaId', 'interestedFocusAreaIds', 'archetypeScores', 'primaryArchetype', 'secondaryArchetype', 'persistedAnswers']) &&
            // State-based restrictions for sensitive fields
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['selectedChallengeId']) ||
              get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.status == 'Challenge Selection Open'
            ) &&
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['teamId', 'solutioning_team_id', 'isAssigned']) ||
              (
                get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.status == 'Team Formation' ||
                get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.status == 'Team Naming Open' ||
                get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.status == 'Team Naming Locked' ||
                get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.status == 'Live'
              )
            ) &&
            (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['discoveryTeamId', 'discovery_team_id', 'interestedFocusAreaId', 'interestedFocusAreaIds']) ||
              (
                get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.status == 'Focus Areas' ||
                get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.status == 'Discovery Team Formation' ||
                get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.status == 'Challenge Discovery' ||
                get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.status == 'Challenge Drafting' ||
                get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.status == 'Challenge Proposing' ||
                get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.status == 'Challenge Voting'
              )
            )
          )
        )
      );
      allow delete: if false; // Trusted removal also cleans the unique pointer.
    }

    function registeredParticipant(sessionId) {
      return get(/databases/$(database)/documents/registrations/$(sessionId + '~' + request.auth.uid)).data.participantId;
    }
    function canCreateForming() {
      let ownId = registeredParticipant(request.resource.data.sessionId);
      return hasActiveProfile() && allocationEligibleData(get(/databases/$(database)/documents/participants/$(ownId)).data) && request.resource.data.leaderId == ownId && request.resource.data.memberIds == [ownId];
    }
    function canUpdateForming() {
      let ownId = registeredParticipant(resource.data.sessionId);
      let beforeMembers = resource.data.memberIds.toSet();
      let afterMembers = request.resource.data.memberIds.toSet();
      return hasActiveProfile() && allocationEligibleData(get(/databases/$(database)/documents/participants/$(ownId)).data) && request.resource.data.sessionId == resource.data.sessionId && request.resource.data.leaderId == resource.data.leaderId && (
        (resource.data.leaderId == ownId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isOpenToMore'])) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds']) && request.resource.data.memberIds.size() == afterMembers.size() && (
          (!(ownId in beforeMembers) && resource.data.isOpenToMore && afterMembers == beforeMembers.union([ownId].toSet())) ||
          (ownId != resource.data.leaderId && ownId in beforeMembers && afterMembers == beforeMembers.difference([ownId].toSet()))
        ))
      );
    }
    function canStaffManageForming() {
      return hasAdminAccess(resource.data.sessionId) &&
        request.resource.data.sessionId == resource.data.sessionId && request.resource.data.leaderId == resource.data.leaderId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'isOpenToMore']) &&
        request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet()).size() == 0 &&
        resource.data.leaderId in request.resource.data.memberIds;
    }
    match /formingTeams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canCreateForming();
      allow update: if isAuthenticated() && (canStaffManageForming() || canUpdateForming());
      allow delete: if isAuthenticated() && (hasAdminAccess(resource.data.sessionId) || resource.data.leaderId == registeredParticipant(resource.data.sessionId));
    }
    match /formingDiscoveryTeams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canCreateForming();
      allow update: if isAuthenticated() && (canStaffManageForming() || canUpdateForming());
      allow delete: if isAuthenticated() && (hasAdminAccess(resource.data.sessionId) || resource.data.leaderId == registeredParticipant(resource.data.sessionId));
    }

    match /discoveryTeams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if hasAdminAccess(request.resource.data.sessionId) && !request.resource.data.keys().hasAny(['leaderId']);
      allow update: if isAuthenticated() && request.resource.data.get('leaderId', null) == resource.data.get('leaderId', null) && request.resource.data.sessionId == resource.data.sessionId && (
        hasAdminAccess(resource.data.sessionId) || (
          hasActiveProfile() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
          allocationEligibleData(get(/databases/$(database)/documents/participants/$(registeredParticipant(resource.data.sessionId))).data) && (
            get(/databases/$(database)/documents/participants/$(registeredParticipant(resource.data.sessionId))).data.get('discoveryTeamId', null) == teamId ||
            get(/databases/$(database)/documents/participants/$(registeredParticipant(resource.data.sessionId))).data.get('discovery_team_id', null) == teamId
          )
        )
      );
      allow delete: if isAuthenticated() && (hasAdminAccess(resource.data.sessionId));
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow create: if hasAdminAccess(request.resource.data.sessionId) && !request.resource.data.keys().hasAny(['leaderId']);
      allow update: if isAuthenticated() && request.resource.data.get('leaderId', null) == resource.data.get('leaderId', null) && request.resource.data.sessionId == resource.data.sessionId && (
        isAdmin() ||
        hasAdminAccess(resource.data.sessionId) ||
        (
          get(/databases/$(database)/documents/sessions/$(resource.data.sessionId)).data.status == 'Team Naming Open' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'nameSubmittedBy']) &&
          get(/databases/$(database)/documents/participants/$(get(/databases/$(database)/documents/registrations/$(resource.data.sessionId + '~' + request.auth.uid)).data.participantId)).data.teamId == teamId
        )
      );
      allow delete: if isAuthenticated() && (hasAdminAccess(resource.data.sessionId));
    }

    match /welcomeResponses/{responseId} {
      allow read: if isAuthenticated();
      allow create: if hasActiveProfile() && request.resource.data.uid == request.auth.uid && request.resource.data.participantId == registeredParticipant(request.resource.data.sessionId);
      allow update: if isAdmin() || hasAdminAccess(resource.data.sessionId) ||
        (isAuthenticated() && (
          (hasActiveProfile() && resource.data.participantId == registeredParticipant(resource.data.sessionId) && request.resource.data.uid == resource.data.uid && request.resource.data.participantId == resource.data.participantId && request.resource.data.sessionId == resource.data.sessionId)
        ));
      allow delete: if isAdmin() || hasAdminAccess(resource.data.sessionId) || (hasActiveProfile() && resource.data.participantId == registeredParticipant(resource.data.sessionId));
    }

    match /focusAreas/{focusAreaId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated() && (hasAdminAccess(request.resource.data.sessionId) || (resource != null && hasAdminAccess(resource.data.sessionId)));
    }

    match /proposedChallenges/{proposedChallengeId} {
      allow read: if isAuthenticated();
      allow create: if hasActiveProfile() && request.resource.data.uid == request.auth.uid && request.resource.data.submitterParticipantId == registeredParticipant(request.resource.data.sessionId);
      allow update: if isAuthenticated() && (
        isAdmin() ||
        hasAdminAccess(resource.data.sessionId) ||
        (hasActiveProfile() && resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid && request.resource.data.sessionId == resource.data.sessionId && resource.data.submitterParticipantId == registeredParticipant(resource.data.sessionId) && request.resource.data.submitterParticipantId == resource.data.submitterParticipantId)
      );
      allow delete: if isAuthenticated() && (isAdmin() || hasAdminAccess(resource.data.sessionId));
    }

    match /proposedChallengeVotes/{voteId} {
      allow read: if isAuthenticated();
      allow create: if hasActiveProfile() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
  }
}
